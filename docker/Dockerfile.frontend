# Build context is the project root (docker-compose sets context: .)
# All COPY paths are relative to the repo root.

# ─── Base ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ─── Dependencies ────────────────────────────────────────────────────────────
FROM base AS deps
COPY frontend/package*.json ./
# ci for reproducible installs; includes devDeps needed for build
RUN npm ci

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM deps AS builder
COPY frontend/ .
ENV NODE_ENV=production
RUN npm run build
# Verify standalone output exists (fails loudly if output: standalone is misconfigured)
RUN test -f .next/standalone/server.js

# ─── Production runner ────────────────────────────────────────────────────────
# Minimal image — only the standalone server + static assets. No source, no devDeps.
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public          ./public

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]

# ─── Development ─────────────────────────────────────────────────────────────
# Runs next dev with hot-reload. Source is volume-mounted by docker-compose.
FROM deps AS development
COPY frontend/ .
ENV NODE_ENV=development
EXPOSE 3000
CMD ["npm", "run", "dev"]
