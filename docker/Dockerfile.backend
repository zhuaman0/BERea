# Build context is the project root.

# ─── Base ────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS base
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# ─── Dependencies ────────────────────────────────────────────────────────────
FROM base AS deps
COPY backend/requirements.txt .
# Pin bcrypt<4 — passlib 1.7.4 is incompatible with bcrypt 4+ (detect_wrap_bug error)
RUN pip install -r requirements.txt "bcrypt<4.0.0"

# ─── Runner (dev + production base) ──────────────────────────────────────────
FROM deps AS runner
COPY backend/ .
EXPOSE 8000

# Development (docker-compose target): source is volume-mounted, reload on change.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "app"]

# ─── Production (default target — Railway builds this) ───────────────────────
# Applies pending migrations, then serves on the platform's $PORT without reload.
FROM deps AS production
COPY backend/ .
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2 --proxy-headers --forwarded-allow-ips='*'"]
