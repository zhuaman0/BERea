{
  "name": "berea",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev   --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint  --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "translate": "npm run translate --workspace=frontend --",
    "i18n:check": "npm run i18n:check --workspace=frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  }
}
