REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# ─── OAuth (fill in when enabling social login) ──────────────────────────────
