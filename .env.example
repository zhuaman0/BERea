POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://berea:berea_dev_password@db:5432/berea_db

# ─── Backend ────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
